# --- Required ---
# Postgres connection string. Example:
#   postgresql+psycopg2://classicscan:secret@localhost:5432/classicscan
DATABASE_URL=

# JWT signing secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Optional ---
# Server port for uvicorn (the app does NOT bind this itself; pass it to uvicorn).
PORT=23000

# Comma-separated CORS origins for the Expo app. Use "*" only for local dev.
# Examples: http://localhost:8081,http://localhost:19006,http://192.168.1.42:8081
CORS_ORIGINS=*

# Where to keep uploaded raw / enhanced / pdf assets per scan.
STORAGE_DIR=./storage

# Per-file upload cap (bytes). Default 25 MiB.
MAX_UPLOAD_BYTES=26214400

# Tesseract binary path (Windows). Leave blank if `tesseract` is on PATH.
TESSERACT_PATH=

# Tesseract language pack used by default.
OCR_LANG=eng

# Set to "1" to dump intermediate OCR pipeline images under backend/ml/debug/.
OCR_DEBUG=0
